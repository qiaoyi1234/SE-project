@startuml
' ============================================================
' 二手交易系统 UML 类图（v1 初稿：商品状态采用状态模式）
' ============================================================
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName "Microsoft YaHei"
skinparam defaultFontSize 13
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam nodesep 22
skinparam ranksep 26
skinparam class {
  BackgroundColor #F7F9FC
  BorderColor #5B7DB1
  ArrowColor #5B7DB1
  HeaderBackgroundColor #E6EDF7
  AttributeFontSize 12
  StereotypeFontSize 11
}
hide empty members
scale 1.5

package "account 用户与权限" as ACC {
  abstract class User {
    - id : Long
    - username : String
    - passwordHash : String
    - role : Role
    - status : AccountStatus
    - bannedUntil : DateTime
    + isBanned() : boolean
    + login(pwd : String) : boolean
  }
  class Buyer {
    + createReservation() : void
  }
  class Seller {
    + publishProduct() : void
    + confirmReservation() : void
  }
  class Admin {
    + auditProduct() : void
    + handleReport() : void
  }
  class LoginAttempt {
    - failCount : int
    - lockedUntil : DateTime
    + recordFailure() : void
    + isLocked() : boolean
  }
  enum Role {
    BUYER
    SELLER
    ADMIN
  }
  enum AccountStatus {
    NORMAL
    BANNED
    CLOSED
  }
}

package "catalog 商品" as CAT {
  class Product {
    - id : Long
    - sellerId : Long
    - title : String
    - price : BigDecimal
    - categoryTag : String
    - state : ProductState
    - version : int
    - deleted : boolean
    + submitForReview() : void
    + takeOffline() : void
    + changePrice(p : BigDecimal) : void
  }
  abstract class ProductState {
    + submit(p : Product) : void
    + approve(p : Product) : void
    + reject(p : Product, reason : String) : void
    + reserve(p : Product) : void
    + confirm(p : Product) : void
    + complete(p : Product) : void
    + takeOffline(p : Product) : void
  }
  class DraftState
  class PendingState
  class RejectedState
  class PublishedState
  class ReservedState
  class TradingState
  class CompletedState
  class OfflineState
  class ProductService {
    + create(cmd : ProductCmd) : Long
    + submitForReview(id : Long) : void
    + audit(id : Long, pass : boolean, reason : String) : void
    + search(query : ProductQuery) : Page<Product>
  }
}

package "trade 交易" as TRD {
  class Reservation {
    - id : Long
    - productId : Long
    - buyerId : Long
    - state : ReservationState
    - createdAt : DateTime
    - confirmDeadline : DateTime
    - version : int
    + confirm() : void
    + cancel() : void
    + expire() : void
    + invalidate() : void
  }
  enum ReservationState {
    WAIT_SELLER
    CONFIRMED
    CANCELLED
    EXPIRED
    INVALIDATED
  }
  class Order {
    - id : Long
    - orderNo : String
    - reservationId : Long
    - productId : Long
    - buyerId : Long
    - state : OrderState
    - placeDeadline : DateTime
    - version : int
    + place() : void
    + complete() : void
    + cancel() : void
    + invalidate() : void
  }
  enum OrderState {
    WAIT_PLACE
    PLACED
    COMPLETED
    CANCELLED
    INVALIDATED
  }
  class TradeService {
    + reserve(productId : Long, buyerId : Long) : Long
    + confirm(reservationId : Long) : void
    + placeOrder(orderId : Long) : void
    + completeOrder(orderId : Long) : void
    + cancelOrder(orderId : Long) : void
  }
  class ContactVisibility {
    - buyerId : Long
    - sellerId : Long
    - productId : Long
    - expireAt : DateTime
  }
}

package "credit 管理（举报/违约/封禁）" as CRE {
  class Report {
    - id : Long
    - reporterId : Long
    - targetType : String
    - targetId : Long
    - reason : String
    - status : ReportStatus
  }
  enum ReportStatus {
    PENDING
    VALID
    INVALID
  }
  class ViolationRecord {
    - id : Long
    - userId : Long
    - type : ViolationType
    - bizId : Long
    - occurredAt : DateTime
  }
  enum ViolationType {
    SELLER_TIMEOUT
    SELLER_OFFLINE
    BUYER_CANCEL
    RULE_BREACH
  }
  class BanRecord {
    - id : Long
    - userId : Long
    - startAt : DateTime
    - endAt : DateTime
    - status : String
  }
  class CreditService {
    + record(userId : Long, type : ViolationType, bizId : Long) : void
    + countIn6Months(userId : Long) : int
    + checkAndBan(userId : Long) : void
  }
}

package "audit 审计与统计" as AUD {
  class OperationLog {
    - id : Long
    - operatorId : Long
    - action : String
    - targetType : String
    - targetId : Long
    - beforeState : String
    - afterState : String
  }
  class StatisticsService {
    + countOnSaleByCategory() : List<StatItem>
    + countDealsOfSeller(sellerId : Long) : List<StatItem>
    + countTradesInRange(start : Date, end : Date) : int
  }
  class Notification {
    - id : Long
    - userId : Long
    - type : String
    - content : String
    - isRead : boolean
  }
}

' ---------------- 关系 ----------------
User <|-- Buyer
User <|-- Seller
User <|-- Admin
User --> Role
User --> AccountStatus
User "1" -- "0..1" LoginAttempt : 登录失败计数 >

Product *-- ProductState : 当前状态
ProductState <|-- DraftState
ProductState <|-- PendingState
ProductState <|-- RejectedState
ProductState <|-- PublishedState
ProductState <|-- ReservedState
ProductState <|-- TradingState
ProductState <|-- CompletedState
ProductState <|-- OfflineState

Seller "1" -- "0..*" Product : 发布 >
Product "1" -- "0..*" Reservation : 被预约 >
Reservation "0..1" -- "0..1" Order : 生成 >
Reservation --> ReservationState
Order --> OrderState
Buyer "1" -- "0..*" Reservation : 发起 >
Buyer "1" -- "0..*" Order : 下单 >

User "1" -- "0..*" ViolationRecord : 累计违约 >
User "1" -- "0..*" BanRecord : 封禁 >
User "1" -- "0..*" Notification : 接收 >
User "1" -- "0..*" Report : 提交举报 >
Product "1" -- "0..*" ContactVisibility : 可见性 >

TradeService ..> Product : 校验商品状态
TradeService ..> Reservation
TradeService ..> Order
TradeService ..> ContactVisibility
ProductService ..> Product
CreditService ..> ViolationRecord
CreditService ..> BanRecord
StatisticsService ..> Order
OperationLog ..> User : 操作人

@enduml
